PORT=4000
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
DB_PATH=data/union.db
# Comma-separated list of browser origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173
# Public base URL used when generating share links
PUBLIC_URL=http://localhost:5173
# Minimum minutes between automatic version snapshots
SNAPSHOT_INTERVAL_MINUTES=5
